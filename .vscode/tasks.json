{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (opencv test)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "build.bat"
            ],
            "options": {
                "cwd": "${workspaceFolder}\\test"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "run (opencv test)",
            "type": "shell",
            "command": "${workspaceFolder}\\test\\build\\test_opencv.exe",
            "options": {
                "cwd": "${workspaceFolder}\\test"
            },
            "dependsOn": [
                "build (opencv test)"
            ],
            "problemMatcher": []
        }
    ]
}
