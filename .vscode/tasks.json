{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (current project)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "build.bat"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
